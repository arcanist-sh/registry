cabal-version:      3.0
name:               arcanist-hello
version:            0.1.0.0
synopsis:           A first package on the arcanist.sh registry
description:
  A minimal library published to <https://registry.arcanist.sh> to show that
  plain cabal resolves, verifies and builds packages from it.
homepage:           https://arcanist.sh/registry/
license:            MIT
license-file:       LICENSE
author:             Raffael Schneider
maintainer:         raffael.schneider@protonmail.com
category:           Example
build-type:         Simple

library
  exposed-modules:  Arcanist.Hello
  hs-source-dirs:   src
  build-depends:    base >=4.18 && <5
  default-language: Haskell2010
